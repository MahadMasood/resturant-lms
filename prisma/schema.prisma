// Prisma schema — Prisma 7 (datasource URL is in prisma.config.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  modules   Module[]
  equipment EquipmentItem[]
}

model User {
  id           String  @id @default(cuid())
  tenantId     String?
  email        String  @unique
  passwordHash String
  name         String
  role         Role    @default(STAFF)

  createdAt DateTime @default(now())

  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  watchProgress WatchProgress[]
  quizAttempts  QuizAttempt[]
  certificates  Certificate[]
}

enum Role {
  SUPER_ADMIN
  MANAGER
  STAFF
}

model Module {
  id          String  @id @default(cuid())
  tenantId    String
  title       String
  description String?
  videoUrl    String
  orderIndex  Int     @default(0)

  createdAt DateTime @default(now())

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  questions     Question[]
  watchProgress WatchProgress[]
  quizAttempts  QuizAttempt[]
  certificates  Certificate[]
}

model Question {
  id            String @id @default(cuid())
  moduleId      String
  questionText  String
  options       Json
  correctAnswer Int

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model WatchProgress {
  id              String  @id @default(cuid())
  userId          String
  moduleId        String
  watchedSeconds  Float   @default(0)
  durationSeconds Float   @default(0)
  completed       Boolean @default(false)

  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
}

model QuizAttempt {
  id       String  @id @default(cuid())
  userId   String
  moduleId String
  score    Float
  passed   Boolean

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])
}

model Certificate {
  id        String    @id @default(cuid())
  userId    String
  moduleId  String
  pdfUrl    String
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
}

enum EquipmentType {
  COOKING_PLATE
  METAL_RING
  SERVING_PLATE
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

model EquipmentItem {
  id         String          @id @default(cuid())
  tenantId   String
  name       String
  type       EquipmentType
  cooksCount Int             @default(0)
  maxCooks   Int             @default(40)
  quantity   Int             @default(1)
  status     EquipmentStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
